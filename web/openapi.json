      "enum": [
       "right",
       "missed",
       "left"
      ],
      "title": "Outcome",
      "type": "string"
     },
     "presented_at": {
      "format": "date-time",
      "title": "Presented At",
      "type": "string"
     },
     "seed": {
      "exclusiveMaximum": 2147483648.0,
      "minimum": 0.0,
      "title": "Seed",
      "type": "integer"
     },
     "session_id": {
      "pattern": "^[0-9a-fA-F-]{8,36}$",
      "title": "Session Id",
      "type": "string"
     },
     "tries": {
      "maximum": 100.0,
      "minimum": 1.0,
      "title": "Tries",
      "type": "integer"
     },
     "version": {
      "minimum": 1.0,
      "title": "Version",
      "type": "integer"
     }
